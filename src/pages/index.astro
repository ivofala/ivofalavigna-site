---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import homeFoto from '../assets/photos/home.jpg';
---

<BaseLayout title="Ivo Falavigna">
  <header class="intro">
    <h1>Ivo Falavigna</h1>
    <p class="lead">
      Vivo a Sanremo. Da anni fotografo i luoghi che attraverso e lavoro il legno nel mio laboratorio. Questo è uno spazio personale dove archivio le due cose.
    </p>
  </header>

  <figure class="home-photo">
    <Image
      src={homeFoto}
      alt="Fiordo tra montagne sotto un cielo coperto, scia dell'acqua in primo piano."
      widths={[560, 1120]}
      sizes="(max-width: 600px) 100vw, 560px"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <section class="sections">
    <a href="/travels" class="section-link">
      <span class="section-label">Travels</span>
    </a>
    <a href="/laboratorio" class="section-link">
      <span class="section-label">Laboratorio</span>
    </a>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 56px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: 24px;
  }

  .lead {
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-text);
    max-width: 480px;
  }

  .home-photo {
    margin: 0 0 72px 0;
  }

  .home-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0;
    padding-top: 40px;
    border-top: 0.5px solid var(--color-border);
  }

  .section-link {
    display: flex;
    align-items: center;
    padding: 16px 0;
    text-decoration: none;
    border-bottom: 0.5px solid var(--color-border);
    transition: color 0.15s ease;
  }

  .section-link:last-child {
    border-bottom: none;
  }

  .section-link:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .section-label {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
  }
</style>